# Supabase (required for Reclaim auth + storage and Google sign-in)
# 1. Create a project at https://supabase.com/dashboard
# 2. Project Settings -> API: copy "Project URL" and "anon public" key here
# 3. Authentication -> Providers -> Google: enable and add OAuth client ID/secret
# 4. Copy this file to .env and restart the dev server (npm run dev)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Voshan admin API settings (optional for local development)
# If Voshan backend runs on 5100 (fallback), leave this as 5100.
# If your Voshan backend runs on 5000, set to http://127.0.0.1:5000
VITE_VOSHAN_PROXY_TARGET=http://127.0.0.1:5100

# Optional: bypass Vite proxy and call Voshan directly from browser.
# Example: http://127.0.0.1:5100/api
# VITE_VOSHAN_API_URL=http://127.0.0.1:5100/api
